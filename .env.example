# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for the authorized administrator (gagadeejay31@gmail.com).
# If omitted, the owner sets a hashed passcode on first login via the Admin panel.
ADMIN_PASSCODE=""

# ADMIN_SESSION_SECRET: Optional HMAC secret for signing admin session tokens.
ADMIN_SESSION_SECRET=""
